{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slipstream-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slipstream-demo-db",
      "database_id": "1cd57202-10e3-4e20-81c5-a0d962d4735d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SLIPSTREAM_KV",
      "id": "7319109e528e4177a931bb3bfe9aae79"
    }
  ],
  // Demo-only: show marketplace figures from the small seeded sample, and a
  // fictional partner contact.
  "vars": {
    "STATS_MIN_SAMPLE": "1",
    "PARTNER_NAME": "Morgan Hale",
    "PARTNER_TITLE": "Partner Manager, Operators",
    // Emails sent by the daily job have no request to take a link origin from.
    "APP_ORIGIN": "https://slipstream-demo.chandler-850.workers.dev"
  },
  // Daily at 14:00 UTC: rating expiry reminders (scheduled() in src/worker.js).
  "triggers": {
    "crons": ["0 14 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
